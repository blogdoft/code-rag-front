server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Angular routing (app.routes.ts) is client-side; unmatched paths fall
    # back to index.html instead of a raw 404.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # CIIR file uploads (features/ciir-upload) can be many GB. nginx's defaults would reject anything
    # over 1 MB (client_max_body_size) and spool the whole body to disk before forwarding a single
    # byte (proxy_request_buffering), which also makes the browser's progress bar track that local
    # spooling instead of the real transfer. Exact match, so only this one path drops the limits -
    # every other /api/ route below keeps nginx's defaults. HTTP/1.1 is required to stream an
    # unbuffered request body upstream.
    location = /api/indexer/ciir-uploads {
        proxy_pass ${API_UPSTREAM}/api/indexer/ciir-uploads;
        proxy_ssl_verify off;

        client_max_body_size 0;
        proxy_request_buffering off;
        proxy_http_version 1.1;
        # The API answers only after streaming the file into object storage, so the response can
        # lag the last uploaded byte by longer than the 60s default for a big file.
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;

        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Reverse proxy for the API gateway (blogdoft.home.arpa/code-brain as of 2026-09-18, see
    # .specs/2026-09-18-gateway-and-projects-migration.md). The URI is spelled out explicitly
    # (.../api/) rather than left bare, since API_UPSTREAM itself now carries a path
    # (.../code-brain) - a bare `proxy_pass ${API_UPSTREAM};` would apply nginx's location/proxy_pass
    # URI-splicing rules to that path too, which only produce the intended result when the upstream
    # has no path component at all. Appending the matched prefix back on unconditionally sidesteps
    # that regardless of whether API_UPSTREAM has a path or not.
    location /api/ {
        proxy_pass ${API_UPSTREAM}/api/;

        # The default upstream (.home.arpa) serves a self-signed certificate
        # (see CLAUDE.md's TLS note). Browsers can't be told to trust that,
        # but nginx here is the proxy, not the browser, so it can skip
        # verification the same way proxy.conf.json's "secure: false" does
        # for the dev server.
        proxy_ssl_verify off;

        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # The API's /version endpoint is deliberately unversioned (no /api prefix) - see
    # .specs/2026-09-04-version-display.md - so it needs its own proxy block; an exact match since
    # the API only exposes this one literal path, unlike /api/ which fans out to many sub-routes.
    location = /version {
        proxy_pass ${API_UPSTREAM}/version;
        proxy_ssl_verify off;

        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
